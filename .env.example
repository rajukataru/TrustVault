# ========================================================
# TrustVault - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials
# ========================================================

# MySQL Database Connection URL
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://trustvault_app:TrustVault2026@localhost:3306/trustvault

# Secret key for signing JWT tokens and session data (minimum 32 characters)
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS

# JWT Algorithm and Token Expiry
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage Directory (relative to project root or absolute path)
STORAGE_PATH=storage/private

# Maximum allowed file upload size in megabytes
MAX_FILE_SIZE_MB=10

# Backend API URL for frontend communication
API_URL=http://127.0.0.1:8000
