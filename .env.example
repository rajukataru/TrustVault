# ========================================================
# TrustVault - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials
# NEVER commit your actual .env file to version control.
# ========================================================

# ---------------------------------------------------------------------------
# REQUIRED — MySQL Database Connection URL
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Local dev example:  mysql+pymysql://trustvault_app:YOUR_PASSWORD@localhost:3306/trustvault
# Aiven cloud example: mysql+pymysql://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:PORT/trustvault
# ---------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/trustvault

# ---------------------------------------------------------------------------
# REQUIRED — Secret key for signing JWT tokens (minimum 32 characters)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS

# ---------------------------------------------------------------------------
# OPTIONAL — Aiven (or any cloud MySQL) SSL CA Certificate
# Set to the path of the downloaded CA .pem file.
# On Render: upload as a Secret File and set the mounted path here,
# e.g. MYSQL_SSL_CA=/etc/secrets/aiven-ca.pem
# Leave unset for local development without SSL.
# ---------------------------------------------------------------------------
# MYSQL_SSL_CA=/path/to/ca.pem

# ---------------------------------------------------------------------------
# OPTIONAL — JWT settings
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# OPTIONAL — Storage & server settings
# ---------------------------------------------------------------------------
# File storage directory (relative to project root or absolute path)
STORAGE_PATH=storage/private

# Maximum allowed file upload size in megabytes
MAX_FILE_SIZE_MB=10

# Backend API URL consumed by the Streamlit frontend
# Production example: https://trustvault-api.onrender.com
API_URL=http://127.0.0.1:8000
